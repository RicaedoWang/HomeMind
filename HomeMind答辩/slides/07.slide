<Slide style={{ width: 1280, height: 720, position: 'relative', overflow: 'hidden', background: '#0B1120', fontFamily: '微软雅黑' }}>
    <Box style={{ height: 110, paddingLeft: 64, paddingRight: 64, paddingTop: 34, flexDirection: 'row', alignItems: 'center', gap: 18 }}>
        <Box style={{ width: 4, height: 34, background: '#38BDF8' }} />
        <Text style={{ fontSize: 36, fontWeight: 700, color: '#F8FAFC', letterSpacing: 0.5 }}>它会记得你说过 26 度</Text>
    </Box>

    <Box style={{ height: 546, paddingLeft: 64, paddingRight: 64, flexDirection: 'column', gap: 24 }}>
        <Box style={{ height: 300, flexDirection: 'column', gap: 12 }}>
            <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 22, background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.45)', borderRadius: 8, paddingLeft: 26, paddingRight: 26 }}>
                <Text style={{ fontSize: 18, fontWeight: 700, color: '#38BDF8', width: 110 }}>短期记忆</Text>
                <Box style={{ width: 900 }}>
                    <Text style={{ fontSize: 19, fontWeight: 700, color: '#F8FAFC' }}>Redis 滑动窗口 · 带 TTL</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(248,250,252,0.55)', marginTop: 6 }}>当前这轮对话的上下文。本机没起 Redis，实际跑进程内存（降级）</Text>
                </Box>
            </Box>

            <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 22, background: '#16223A', border: '1px solid rgba(248,250,252,0.10)', borderRadius: 8, paddingLeft: 26, paddingRight: 26, marginLeft: 60 }}>
                <Text style={{ fontSize: 18, fontWeight: 700, color: '#F8FAFC', width: 110 }}>长期记忆</Text>
                <Box style={{ width: 800 }}>
                    <Text style={{ fontSize: 19, fontWeight: 700, color: '#F8FAFC' }}>SQLite · 版本留痕</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(248,250,252,0.55)', marginTop: 6 }}>跨会话的习惯。改口不覆盖旧记录，version +1 并进 history</Text>
                </Box>
            </Box>

            <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 22, background: '#16223A', border: '1px solid rgba(248,250,252,0.10)', borderRadius: 8, paddingLeft: 26, paddingRight: 26, marginLeft: 120 }}>
                <Text style={{ fontSize: 18, fontWeight: 700, color: '#F8FAFC', width: 110 }}>语义记忆</Text>
                <Box style={{ width: 700 }}>
                    <Text style={{ fontSize: 19, fontWeight: 700, color: '#F8FAFC' }}>字符 bigram Jaccard</Text>
                    <Text style={{ fontSize: 15, color: 'rgba(248,250,252,0.55)', marginTop: 6 }}>写入时查重，相似度 ≥ 0.85 判为同一条。Milvus 真向量未接</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ height: 222, flexDirection: 'row', gap: 24 }}>
            <Box style={{ width: 690, background: '#16223A', border: '1px solid rgba(248,250,252,0.10)', borderRadius: 10, padding: '24px 28px' }}>
                <Text style={{ fontSize: 13, color: '#38BDF8', letterSpacing: 2, fontWeight: 700 }}>召回不是简单 Top-K</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 10, marginTop: 14 }}>
                    <Text style={{ fontSize: 40, fontWeight: 700, color: '#38BDF8', fontFamily: 'Consolas' }}>0.6</Text>
                    <Text style={{ fontSize: 17, color: 'rgba(248,250,252,0.62)' }}>语义相似</Text>
                    <Text style={{ fontSize: 22, color: 'rgba(248,250,252,0.35)', marginLeft: 6 }}>+</Text>
                    <Text style={{ fontSize: 40, fontWeight: 700, color: '#F8FAFC', fontFamily: 'Consolas', marginLeft: 6 }}>0.2</Text>
                    <Text style={{ fontSize: 17, color: 'rgba(248,250,252,0.62)' }}>时效</Text>
                    <Text style={{ fontSize: 22, color: 'rgba(248,250,252,0.35)', marginLeft: 6 }}>+</Text>
                    <Text style={{ fontSize: 40, fontWeight: 700, color: '#F8FAFC', fontFamily: 'Consolas', marginLeft: 6 }}>0.2</Text>
                    <Text style={{ fontSize: 17, color: 'rgba(248,250,252,0.62)' }}>重要度</Text>
                </Box>
                <Text style={{ fontSize: 17, color: 'rgba(248,250,252,0.58)', lineHeight: 1.75, marginTop: 14 }}>
                    权重可解释、可调——答辩时能当场改配置看结果变化。
                </Text>
            </Box>

            <Box style={{ width: 438, background: 'rgba(56,189,248,0.06)', border: '1px solid rgba(56,189,248,0.28)', borderRadius: 10, padding: '24px 28px' }}>
                <Text style={{ fontSize: 13, color: '#38BDF8', letterSpacing: 2, fontWeight: 700 }}>记忆最有价值的标志</Text>
                <Text style={{ fontSize: 21, fontWeight: 700, color: '#F8FAFC', lineHeight: 1.6, marginTop: 12 }}>
                    它能反向改变行为
                </Text>
                <Text style={{ fontSize: 17, color: 'rgba(248,250,252,0.60)', lineHeight: 1.75, marginTop: 10 }}>
                    说"把空调打开"，它会按你记下的偏好设成 26 度——而不是等你再说一遍。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 64, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: 'rgba(248,250,252,0.40)' }}>HomeMind · 智能家居多智能体中枢</Text>
        <Text style={{ fontSize: 13, color: 'rgba(248,250,252,0.40)', fontFamily: 'Consolas' }}>07 / 13</Text>
    </Box>
</Slide>
