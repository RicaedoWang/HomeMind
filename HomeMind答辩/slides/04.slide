<Slide style={{ width: 1280, height: 720, position: 'relative', overflow: 'hidden', background: '#0B1120', fontFamily: '微软雅黑' }}>
    <Box style={{ height: 110, paddingLeft: 64, paddingRight: 64, paddingTop: 34, flexDirection: 'row', alignItems: 'center', gap: 18 }}>
        <Box style={{ width: 4, height: 34, background: '#38BDF8' }} />
        <Text style={{ fontSize: 36, fontWeight: 700, color: '#F8FAFC', letterSpacing: 0.5 }}>系统架构设计</Text>
    </Box>

    <Box style={{ height: 546, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', gap: 48 }}>
        <Box style={{ width: 560, flexDirection: 'column', gap: 10, justifyContent: 'center' }}>
            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 700, color: '#38BDF8', width: 70 }}>编排</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.66)' }}>LangGraph 两张图：单 Agent 主链路 + Supervisor 多 Agent</Text>
            </Box>
            <Box style={{ height: 1, background: 'rgba(248,250,252,0.08)' }} />
            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 700, color: '#38BDF8', width: 70 }}>模型</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.66)' }}>DeepSeek + 规则引擎兜底（双模，任一可独立跑通）</Text>
            </Box>
            <Box style={{ height: 1, background: 'rgba(248,250,252,0.08)' }} />
            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 700, color: '#38BDF8', width: 70 }}>工具</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.66)' }}>自建 ToolRegistry：超时 / 重试 / 熔断 / 幂等</Text>
            </Box>
            <Box style={{ height: 1, background: 'rgba(248,250,252,0.08)' }} />
            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 700, color: '#38BDF8', width: 70 }}>记忆</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.66)' }}>短期 Redis + 长期 SQLite + 语义本地 embedding</Text>
            </Box>
            <Box style={{ height: 1, background: 'rgba(248,250,252,0.08)' }} />
            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 700, color: '#38BDF8', width: 70 }}>隔离</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.66)' }}>JWT + PBKDF2 · family_id 全链路穿透</Text>
            </Box>
            <Box style={{ height: 1, background: 'rgba(248,250,252,0.08)' }} />
            <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 700, color: '#38BDF8', width: 70 }}>前端</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.66)' }}>零构建原生 Web（无 React/Vite），移动端优先</Text>
            </Box>
        </Box>

        <Box style={{ width: 560, flexDirection: 'column', gap: 16, justifyContent: 'center' }}>
            <Box style={{ background: '#16223A', border: '1px solid rgba(56,189,248,0.22)', borderRadius: 10, padding: '20px 24px' }}>
                <Text style={{ fontSize: 13, color: '#38BDF8', fontFamily: 'Consolas', fontWeight: 700, letterSpacing: 1 }}>亮点 1</Text>
                <Text style={{ fontSize: 20, fontWeight: 700, color: '#F8FAFC', marginTop: 8 }}>治理逻辑只有一处</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.58)', lineHeight: 1.7, marginTop: 8 }}>超时/重试/熔断/幂等统一在 execution，主链路与子 Agent 共用，禁止各写一套。</Text>
            </Box>
            <Box style={{ background: '#16223A', border: '1px solid rgba(56,189,248,0.22)', borderRadius: 10, padding: '20px 24px' }}>
                <Text style={{ fontSize: 13, color: '#38BDF8', fontFamily: 'Consolas', fontWeight: 700, letterSpacing: 1 }}>亮点 2</Text>
                <Text style={{ fontSize: 20, fontWeight: 700, color: '#F8FAFC', marginTop: 8 }}>多 Agent 是职责隔离，不是多个模型</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.58)', lineHeight: 1.7, marginTop: 8 }}>三个子 Agent 各有工具白名单，日程管家拿不到门锁——这是第二道安全防线。</Text>
            </Box>
            <Box style={{ background: '#16223A', border: '1px solid rgba(56,189,248,0.22)', borderRadius: 10, padding: '20px 24px' }}>
                <Text style={{ fontSize: 13, color: '#38BDF8', fontFamily: 'Consolas', fontWeight: 700, letterSpacing: 1 }}>亮点 3</Text>
                <Text style={{ fontSize: 20, fontWeight: 700, color: '#F8FAFC', marginTop: 8 }}>人机协同：把"不误操作"做成硬约束</Text>
                <Text style={{ fontSize: 16, color: 'rgba(248,250,252,0.58)', lineHeight: 1.7, marginTop: 8 }}>有歧义反问、高危二次确认——不是提示词里的请求，是代码里的闸。</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 64, paddingLeft: 64, paddingRight: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 13, color: 'rgba(248,250,252,0.40)' }}>HomeMind · 智能家居 AI 管家</Text>
        <Text style={{ fontSize: 13, color: 'rgba(248,250,252,0.40)', fontFamily: 'Consolas' }}>04 / 15</Text>
    </Box>
</Slide>
