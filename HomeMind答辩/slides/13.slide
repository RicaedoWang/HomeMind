        </Box>

        <Box style={{ width: 424, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.32)', borderRadius: 12, padding: '28px 30px' }}>
                <Text style={{ fontSize: 12, color: 'rgba(248,250,252,0.45)', letterSpacing: 2 }}>项目规模</Text>
                <Text style={{ fontSize: 68, fontWeight: 700, color: '#38BDF8', fontFamily: 'Consolas', lineHeight: 1, marginTop: 10 }}>16,531</Text>
