    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, background: 'linear-gradient(105deg, rgba(11,17,32,0.97) 0%, rgba(11,17,32,0.90) 50%, rgba(11,17,32,0.66) 100%)' }} />

    <Box style={{ position: 'relative', zIndex: 1, width: 1280, height: 720, paddingLeft: 80, paddingRight: 80, paddingTop: 64, paddingBottom: 56, flexDirection: 'row', gap: 56 }}>
        <Box style={{ width: 640, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box>
                <Text style={{ fontSize: 13, color: '#38BDF8', letterSpacing: 4, fontWeight: 700 }}>THANKS FOR LISTENING</Text>
