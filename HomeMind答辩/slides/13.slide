                <Box style={{ width: 60, height: 3, background: '#38BDF8', marginTop: 26 }} />
            </Box>

            <Box style={{ flexDirection: 'row', gap: 12, flexWrap: 'wrap', width: 620 }}>
                <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.30)', borderRadius: 6, padding: '10px 18px' }}>
                    <Text style={{ fontSize: 15, color: '#38BDF8' }}>LangGraph</Text>
                </Box>
                <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.30)', borderRadius: 6, padding: '10px 18px' }}>
                    <Text style={{ fontSize: 15, color: '#38BDF8' }}>多 Agent 协同</Text>
                </Box>
                <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.30)', borderRadius: 6, padding: '10px 18px' }}>
                    <Text style={{ fontSize: 15, color: '#38BDF8' }}>三层记忆</Text>
                </Box>
                <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.30)', borderRadius: 6, padding: '10px 18px' }}>
                    <Text style={{ fontSize: 15, color: '#38BDF8' }}>家庭级多租户</Text>
                </Box>
                <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.30)', borderRadius: 6, padding: '10px 18px' }}>
                    <Text style={{ fontSize: 15, color: '#38BDF8' }}>四层测试体系</Text>
                </Box>
                <Box style={{ background: 'rgba(56,189,248,0.10)', border: '1px solid rgba(56,189,248,0.30)', borderRadius: 6, padding: '10px 18px' }}>
                    <Text style={{ fontSize: 15, color: '#38BDF8' }}>工具治理</Text>
