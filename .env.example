# HomeMind 环境配置示例
# 使用方式：复制为 .env 后按实际修改。所有项都有默认值，不配也能启动。

# ---- 基础 ----
HM_ENV=development
HM_LOG_LEVEL=INFO

# ---- 大模型 ----
# true = 规则解析（离线可跑，默认）；false = 调用真实大模型 API
HM_USE_MOCK_LLM=true
HM_LLM_PROVIDER=deepseek
HM_LLM_MODEL=deepseek-chat
HM_LLM_API_KEY=
HM_LLM_BASE_URL=https://api.deepseek.com/v1
HM_LLM_TIMEOUT=30
HM_LLM_TEMPERATURE=0.1

# ---- Redis（短期记忆）----
# 设为 false 或不装 redis 包 → 自动降级为进程内存
HM_REDIS_ENABLED=true
HM_REDIS_HOST=localhost
HM_REDIS_PORT=6379
HM_REDIS_PASSWORD=
HM_REDIS_TTL=86400

# ---- 工具治理（对齐 FR-TOOL-003）----
HM_TOOL_TIMEOUT=5.0
HM_TOOL_MAX_RETRIES=2
HM_TOOL_CB_THRESHOLD=3

# ---- 记忆召回权重（对齐 FR-MEM-005）----
HM_MEM_WINDOW=20
HM_MEM_ALPHA=0.6
HM_MEM_BETA=0.2
HM_MEM_GAMMA=0.2
HM_MEM_LAMBDA=0.01

# ---- 安全护栏（对齐 FR-SEC-001）----
HM_REQUIRE_CONFIRM=true
HM_CONFIDENCE_THRESHOLD=0.7

# ---- 本地 Embedding（语义召回的真向量模式）----
# true  = 尝试加载本地模型，语义召回走真向量（能认出同义改写）
# false = 直接用字符 bigram Jaccard（只认字面重合）
# 无论设什么，模型加载/下载失败都会自动降级，不会让服务起不来
HM_EMBEDDING_ENABLED=true
HM_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 国内网络**必须**设镜像，否则首次下载大概率超时（实测重试 3 次共 70 秒）
# 也可以提前跑 python scripts/download_embedding.py 把模型下好
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_SYMLINKS=1
